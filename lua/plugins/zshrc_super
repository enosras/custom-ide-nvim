# Powerlevel10k instant prompt (keep near top)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---------------------------
# Environment / PATH / Local
# ---------------------------
export MANPATH="/usr/local/man:$MANPATH"
export HISTFILE="$HOME/.zsh_history"
HISTSIZE=1000000
SAVEHIST=1000000

export TERM=xterm-256color
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export DISPLAY=:2
export REQUEST_CA_BUNDLE=/Library/Frameworks/Python.framework/Versions/3.12/lib/python3.12/site-packages/certifi/cacert.pem

# User PATH additions (keep your custom paths)
export PATH="$HOME/.local/bin:/usr/local/bin:/usr/local/sbin:/opt/homebrew/bin:/opt/homebrew/opt/ruby/bin:/Users/enos/go/bin:$PATH"

# ---------------------------
# History behavior
# ---------------------------
setopt append_history inc_append_history share_history
setopt EXTENDED_HISTORY
setopt HIST_IGNORE_SPACE HIST_IGNORE_DUPS HIST_REDUCE_BLANKS
setopt autocd auto_param_slash no_case_glob no_case_match globdots extended_glob interactive_comments
unsetopt prompt_sp

# ---------------------------
# Oh My Zsh + plugins + theme
# ---------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
ENABLE_CORRECTION="true"
# Plugins (keep yours)
plugins=(git zsh-syntax-highlighting zsh-autosuggestions fzf-tab zoxide ansible terraform kubectl aws gh rust tmux)
source $ZSH/oh-my-zsh.sh

# Source syntax-highlighting if custom path
source ~/.zsh/catppuccin_mocha-zsh-syntax-highlighting.zsh

# Powerlevel10k config (if present)
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# Enable bash completion compatibility where needed
autoload -U +X bashcompinit && bashcompinit

# ---------------------------
# Runtime tool / manager initialization
# ---------------------------
# mise, cargo, tv, broot, thefuck
eval "$(~/.local/bin/mise activate zsh)" 2>/dev/null || true
source "$HOME/.cargo/env" 2>/dev/null || true
eval "$(tv init zsh)" 2>/dev/null || true
source /Users/enos/.config/broot/launcher/bash/br 2>/dev/null || true
eval $(thefuck --alias) 2>/dev/null || true

# Editor selection
if [[ -n $SSH_CONNECTION ]]; then
  export EDITOR='vim'
else
  export EDITOR='nvim'
fi

