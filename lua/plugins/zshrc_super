# ---------------------------
# fzf + fzf-tab configuration (consolidated)
# ---------------------------
export FZF_DEFAULT_COMMAND="fd --hidden --strip-cwd-prefix --exclude .git"
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_ALT_C_COMMAND="fd --type=d --hidden --strip-cwd-prefix --exclude .git"
export FZF_TMUX_OPTS="-p 90%,70%"

export FZF_DEFAULT_OPTS="
  --height=60% --preview-window='right:50%:hidden:wrap' --bind='ctrl-/:toggle-preview' --preview-label='preview' --layout=reverse --border=rounded --margin=1 \
  --color=bg+:#313244,bg:#1E1E2E,spinner:#F5E0DC,hl:#F38BA8,fg:#CDD6F4,header:#F38BA8,info:#CBA6F7,pointer:#F5E0DC \
  --color=marker:#B4BEFE,fg+:#CDD6F4,prompt:#CBA6F7,hl+:#F38BA8,selected-bg:#45475A,border:#6C7086,label:#CDD6F4
"

# fzf-tab: consolidated zstyle rules

# -- -- --- -- -- Force fzf-tab to request a 15-line dropdown menu and minimum size bounds
# zstyle ':fzf-tab:*' fzf-flags --height=15 --min-height=10
# Re-enable the list body and ensure a proper multi-line dropdown box
zstyle ':fzf-tab:*' fzf-flags --preview-window=right:60% --height=15 --min-height=10
zstyle ':completion:*' menu no
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}
zstyle ':fzf-tab:*' fzf-flags --border=rounded --style=full --color=fg:1,fg+:2
zstyle ':fzf-tab:*' use-fzf-default-opts yes
zstyle ':fzf-tab:*' switch-group 'left' 'right'
zstyle ':fzf-tab:*' fzf-pad 4

# Generic preview logic
zstyle ':fzf-tab:complete:*:*' fzf-preview '
  case "$group" in
    *file*|*directory*|*path*)
      if [ -d "$realpath" ]; then
        eza --color=always --long --git --icons=always --no-user --no-time "$realpath" 2>/dev/null || eza --color=always --long "$realpath"
      elif [ -f "$realpath" ]; then
        bat --color=always --style=header,grid,numbers --line-range=:100 "$realpath" 2>/dev/null || cat "$realpath"
      fi
      ;;
    *)
      printf "\e[1;34mCommand Context:\e[0m %s\n" "$fzf_meta_completion"
      printf "\e[1;32mSelected Item:\e[0m %s\n" "$word"
      printf "\e[1;33mDescription:\e[0m %s\n" "$(man $word 2>/dev/null || echo \"No manual entry for $word\")"
      ;;
  esac
'

# Command-specific previews
## Force fzf-tab to give the preview exactly half the space, or put it on top/bottom
zstyle ':fzf-tab:*' fzf-flags --height=60% --preview-window=right:50%

zstyle ':fzf-tab:complete:cat:*' fzf-preview 'bat --color=always --style=plain "$realpath"'

zstyle ':fzf-tab:complete:glow:*' fzf-preview 'bat --color=always --style=plain "$realpath"'
zstyle ':fzf-tab:complete:less:*' fzf-preview 'bat --color=always --style=plain "$realpath"'
zstyle ':fzf-tab:complete:vim:*' fzf-preview 'bat --color=always --style=plain "$realpath"'
zstyle ':fzf-tab:complete:man:*' fzf-preview 'man $word 2>/dev/null | col -bx | bat --language=man --color=always --style=plain 2>/dev/null || echo "No manual entry"'
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always --long --tree --level=2 --icons=always "${realpath:-.}" 2>/dev/null || ls -la "${realpath:-.}"'
