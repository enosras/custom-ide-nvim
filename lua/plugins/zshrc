# Core fallback style for generalized commands
zstyle ':fzf-tab:complete:*:*' fzf-preview '
  case "$group" in
    "file"|"directory"|"path"|*"file"*)
      if [ -d "$realpath" ]; then
        eza --color=always --long --git --icons=always --no-user --no-time "$realpath" 2>/dev/null || eza --color=always --long "$realpath"
      elif [ -f "$realpath" ]; then
        bat --color=always --style=header,grid,numbers --line-range=:100 "$realpath" 2>/dev/null || cat "$realpath"
      fi
      ;;
    *)
      # General metadata block for non-file options
      printf "\e[1;34mCommand Context:\e[0m %s\n" "$fzf_meta_completion"
      printf "\e[1;32mSelected Item:\e[0m %s\n" "$word"
      printf "\e[1;33mDescription:\e[0m %s\n" "$desc"
      ;;
  esac
'

