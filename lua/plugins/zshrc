fzf-doc() {
  fzf --style full \
    --preview '
      # Sanitize the input token by wrapping it securely in quotes
      local item="{}"
      
      if [ -z "$item" ]; then
        echo "No input selection detected."
      # Safely query if the first isolated word is an executable or shell alias
      elif type "${item%% *}" >/dev/null 2>&1; then
        man "${item%% *}" 2>/dev/null | col -bx || "${item%% *}" --help 2>&1
      else
        fzf-preview.sh "$item" 2>/dev/null || file --brief "$item" 2>/dev/null
      fi
    ' \
    --bind 'focus:transform-header:file --brief {}'
}

